{
  "name": "marketing-service",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "check-types": "tsc --noEmit -p tsconfig.build.json",
    "start": "node dist/main",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest",
    "db:migrate": "prisma migrate dev",
    "db:generate": "echo \"No Prisma models to generate for marketing-service\""
  },
  "dependencies": {
    "@apollo/server": "^4.11.0",
    "@golevelup/nestjs-rabbitmq": "^4.0.0",
    "@nestjs/apollo": "^12.2.0",
    "@nestjs/bullmq": "^10.2.0",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/graphql": "^12.2.0",
    "@nestjs/microservices": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/swagger": "^7.4.2",
    "@prisma/client": "^5.18.0",
    "@sentry/nestjs": "^8.26.0",
    "@sentry/node": "^8.26.0",
    "@work-phelo/config": "file:../../packages/config",
    "@work-phelo/schemas": "file:../../packages/schemas",
    "@work-phelo/types": "file:../../packages/types",
    "@work-phelo/utils": "file:../../packages/utils",
    "amqplib": "^0.10.4",
    "bullmq": "^5.12.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "csv-parser": "^3.0.0",
    "graphql": "^16.9.0",
    "ioredis": "^5.4.1",
    "nest-winston": "^1.9.7",
    "reflect-metadata": "^0.1.14",
    "resend": "^3.4.0",
    "rxjs": "^7.8.1",
    "winston": "^3.14.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.3.0",
    "@types/amqplib": "^0.10.5",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.19.40",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prisma": "^5.18.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node",
    "passWithNoTests": true
  }
}
