{
  "name": "notification-service",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "prebuild": "npm run db:generate",
    "build": "nest build",
    "precheck-types": "npm run db:generate",
    "check-types": "tsc --noEmit -p tsconfig.build.json",
    "start": "node dist/main",
    "prelint": "npm run db:generate",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@golevelup/nestjs-rabbitmq": "^4.0.0",
    "@nestjs/bullmq": "^10.2.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/microservices": "^10.4.22",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/platform-socket.io": "^10.3.0",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/websockets": "^10.3.0",
    "@prisma/client": "^5.18.0",
    "@react-email/render": "^0.0.16",
    "@sentry/nestjs": "^8.26.0",
    "@sentry/node": "^8.26.0",
    "@types/nodemailer": "^7.0.11",
    "@work-phelo/config": "file:../../packages/config",
    "@work-phelo/schemas": "file:../../packages/schemas",
    "@work-phelo/types": "file:../../packages/types",
    "@work-phelo/utils": "file:../../packages/utils",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^0.10.9",
    "axios": "^1.14.0",
    "bullmq": "^5.12.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "firebase-admin": "^12.3.0",
    "handlebars": "^4.7.8",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "nest-winston": "^1.9.7",
    "nodemailer": "^8.0.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "reflect-metadata": "^0.1.14",
    "rxjs": "^7.8.1",
    "socket.io": "^4.7.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.14.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.3.0",
    "@types/amqplib": "^0.10.8",
    "@types/express": "^5.0.6",
    "@types/handlebars": "^4.1.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.19.40",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prisma": "^5.18.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node",
    "passWithNoTests": true
  }
}
